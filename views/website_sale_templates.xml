<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_sale_address_form_fields_custom" inherit_id="website_sale.address_form_fields">
        <!-- 1. Replace Name field with First/Last Name -->
        <xpath expr="//div[@id='div_name']" position="replace">
            <div class="row g-3 uk-checkout-name-row">
                <div class="col-md-6 mb-2">
                    <label class="col-form-label" for="first_name">First Name</label>
                    <input type="text"
                           name="first_name"
                           id="first_name"
                           class="form-control"
                           required="required"
                           t-att-value="(checkout.get('first_name') if checkout else '') or (partner_sudo.x_first_name if partner_sudo else '')"/>
                </div>
                <div class="col-md-6 mb-2">
                    <label class="col-form-label" for="last_name">Last Name</label>
                    <input type="text"
                           name="last_name"
                           id="last_name"
                           class="form-control"
                           required="required"
                           t-att-value="(checkout.get('last_name') if checkout else '') or (partner_sudo.x_last_name if partner_sudo else '')"/>
                </div>
                <input type="hidden"
                       name="name"
                       id="uk_hidden_full_name"
                       t-att-value="(checkout.get('name') if checkout else '') or (partner_sudo.name if partner_sudo else '')"/>
            </div>
        </xpath>

        <!-- 2. Remove B2B fields (Company and VAT) -->
        <xpath expr="//t[@name='b2b_fields']" position="replace"/>

        <!-- 4. Zip label and validation -->
        <xpath expr="//label[@for='o_zip']|//div[@id='div_zip']//label|//label[contains(string(), 'Zip') or contains(string(), 'ZIP')]" position="replace" allow_multiple="1">
            <label class="col-form-label" for="o_zip">Postal Code</label>
        </xpath>
        <xpath expr="//input[@name='zip']" position="attributes">
            <attribute name="placeholder">e.g. SW1A 1AA</attribute>
            <attribute name="pattern">^[A-Z]{1,2}[0-9][A-Z0-9]?\s?[0-9][A-Z]{2}$</attribute>
            <attribute name="title">Enter a valid UK Postal Code, e.g. SW1A 1AA</attribute>
            <attribute name="oninput">this.value = this.value.toUpperCase()</attribute>
        </xpath>

        <!-- 5. Lock Country field to United Kingdom -->
        <xpath expr="//select[@name='country_id']" position="attributes">
            <attribute name="readonly">1</attribute>
            <attribute name="class" add="uk-readonly-field" separator=" "/>
            <attribute name="title">Shipping is currently only available to the United Kingdom.</attribute>
        </xpath>

        <!-- 6. Hide State / Province field -->
        <xpath expr="//div[@id='div_state']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>

        <!-- 6b. Clear placeholder for main phone field -->
        <xpath expr="//input[@name='phone']" position="attributes">
            <attribute name="placeholder"></attribute>
        </xpath>

        <!-- 7. Marketing opt-in checkbox after email field -->
        <xpath expr="//div[@id='div_email']" position="after">
            <div class="mb-3 form-check uk-marketing-opt-in">
                <input type="checkbox"
                       class="form-check-input"
                       id="x_marketing_opt_in"
                       name="x_marketing_opt_in"
                       t-att-checked="'checked' if (not partner_sudo or partner_sudo.id == request.website.user_id.sudo().partner_id.id or partner_sudo.x_marketing_opt_in) else None"/>
                <label class="form-check-label" for="x_marketing_opt_in">
                    I’d like to receive news, offers, and product updates by email.
                </label>
            </div>
        </xpath>
    </template>

    <template id="website_sale_address_custom" inherit_id="website_sale.address">
        <xpath expr="//t[@t-call='website_sale.address_form_fields']" position="after">
            <!-- Checkbox for different billing address -->
            <div class="mb-3 form-check uk-billing-different-opt mt-4">
                <input type="checkbox"
                       class="form-check-input"
                       id="billing_different"
                       name="billing_different"
                       t-att-checked="'checked' if has_different_billing else None"/>
                <label class="form-check-label fw-bold" for="billing_different">
                    Billing address is different from delivery address
                </label>
            </div>

            <!-- Billing Address Form Container -->
            <div id="billing_address_container" t-att-style="'' if has_different_billing else 'display: none;'">
                <h4 class="mt-4 mb-3 border-top pt-3">Billing Address</h4>
                
                <div class="row g-3 uk-checkout-name-row">
                    <div class="col-md-6 mb-2">
                        <label class="col-form-label" for="billing_first_name">First Name</label>
                        <input type="text"
                               name="billing_first_name"
                               id="billing_first_name"
                               class="form-control"
                               t-att-required="'required' if has_different_billing else None"
                               t-att-value="billing_partner.x_first_name if billing_partner else ''"/>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="col-form-label" for="billing_last_name">Last Name</label>
                        <input type="text"
                               name="billing_last_name"
                               id="billing_last_name"
                               class="form-control"
                               t-att-required="'required' if has_different_billing else None"
                               t-att-value="billing_partner.x_last_name if billing_partner else ''"/>
                    </div>
                </div>

                <div class="mb-3" id="div_billing_phone">
                    <label class="col-form-label" for="billing_phone">Phone</label>
                    <input type="tel"
                           name="billing_phone"
                           id="billing_phone"
                           class="form-control"
                           t-att-value="billing_partner.phone if billing_partner else ''"/>
                </div>

                <div class="mb-3" id="div_billing_street">
                    <label class="col-form-label" for="billing_street">Street and Number</label>
                    <input type="text"
                           name="billing_street"
                           id="billing_street"
                           class="form-control"
                           t-att-required="'required' if has_different_billing else None"
                           t-att-value="billing_partner.street if billing_partner else ''"
                           placeholder="Enter a location"/>
                </div>

                <div class="mb-3" id="div_billing_street2">
                    <label class="col-form-label" for="billing_street2">Apartment, suite, etc.</label>
                    <input type="text"
                           name="billing_street2"
                           id="billing_street2"
                           class="form-control"
                           t-att-value="billing_partner.street2 if billing_partner else ''"/>
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-3" id="div_billing_city">
                        <label class="col-form-label" for="billing_city">City</label>
                        <input type="text"
                               name="billing_city"
                               id="billing_city"
                               class="form-control"
                               t-att-required="'required' if has_different_billing else None"
                               t-att-value="billing_partner.city if billing_partner else ''"/>
                    </div>
                    <div class="col-md-6 mb-3" id="div_billing_zip">
                        <label class="col-form-label" for="billing_zip">Postal Code</label>
                        <input type="text"
                               name="billing_zip"
                               id="billing_zip"
                               class="form-control"
                               placeholder="e.g. SW1A 1AA"
                               t-att-required="'required' if has_different_billing else None"
                               t-att-value="billing_partner.zip if billing_partner else ''"/>
                    </div>
                </div>

                <div class="mb-3" id="div_billing_country">
                    <label class="col-form-label" for="billing_country_id">Country</label>
                    <select name="billing_country_id"
                            id="billing_country_id"
                            class="form-select"
                            t-att-required="'required' if has_different_billing else None">
                        <option value="" disabled="disabled">Select a country...</option>
                        <t t-foreach="countries" t-as="c">
                            <option t-att-value="c.id"
                                    t-att-selected="c.id == (billing_partner.country_id.id if billing_partner else country.id)">
                                <t t-esc="c.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>
        </xpath>
    </template>

    <template id="website_sale_checkout_custom" inherit_id="website_sale.checkout">
        <xpath expr="//t[@t-call='website_sale.billing_address_row']" position="replace">
            <!-- Removed Billing Address section since it is configured on /shop/address -->
        </xpath>
    </template>
</odoo>
