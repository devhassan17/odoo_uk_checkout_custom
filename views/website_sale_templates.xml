<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_sale_address_form_fields_custom" inherit_id="website_sale.address_form_fields">
        <!-- 1. Replace Name field with First/Last Name -->
        <xpath expr="//div[@id='div_name']" position="replace">
            <div class="row g-3 uk-checkout-name-row">
                <div class="col-md-6 mb-2">
                    <label class="col-form-label" for="first_name">First Name</label>
                    <input type="text"
                           name="first_name"
                           id="first_name"
                           class="form-control"
                           required="required"
                           t-att-value="(checkout.get('first_name') if checkout else '') or (partner_sudo.x_first_name if partner_sudo else '')"/>
                </div>
                <div class="col-md-6 mb-2">
                    <label class="col-form-label" for="last_name">Last Name</label>
                    <input type="text"
                           name="last_name"
                           id="last_name"
                           class="form-control"
                           required="required"
                           t-att-value="(checkout.get('last_name') if checkout else '') or (partner_sudo.x_last_name if partner_sudo else '')"/>
                </div>
                <input type="hidden"
                       name="name"
                       id="uk_hidden_full_name"
                       t-att-value="(checkout.get('name') if checkout else '') or (partner_sudo.name if partner_sudo else '')"/>
            </div>
        </xpath>

        <!-- 2. Remove B2B fields (Company and VAT) -->
        <xpath expr="//t[@name='b2b_fields']" position="replace"/>

        <!-- 4. Zip label and validation -->
        <xpath expr="//label[@for='o_zip']|//div[@id='div_zip']//label|//label[contains(string(), 'Zip') or contains(string(), 'ZIP')]" position="replace" allow_multiple="1">
            <label class="col-form-label" for="o_zip">Postal Code</label>
        </xpath>
        <xpath expr="//input[@name='zip']" position="attributes">
            <attribute name="placeholder">e.g. SW1A 1AA</attribute>
            <attribute name="pattern">^[A-Z]{1,2}[0-9][A-Z0-9]?\s?[0-9][A-Z]{2}$</attribute>
            <attribute name="title">Enter a valid UK Postal Code, e.g. SW1A 1AA</attribute>
            <attribute name="oninput">this.value = this.value.toUpperCase()</attribute>
        </xpath>

        <!-- 5. Lock Country field to United Kingdom -->
        <xpath expr="//select[@name='country_id']" position="attributes">
            <attribute name="readonly">1</attribute>
            <attribute name="class" add="uk-readonly-field" separator=" "/>
            <attribute name="title">Shipping is currently only available to the United Kingdom.</attribute>
        </xpath>

        <!-- 6. Hide State / Province field -->
        <xpath expr="//div[@id='div_state']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>

        <!-- 6b. Clear placeholder for main phone field -->
        <xpath expr="//input[@name='phone']" position="attributes">
            <attribute name="placeholder"></attribute>
        </xpath>

        <!-- 7. Marketing opt-in checkbox after email field -->
        <xpath expr="//div[@id='div_email']" position="after">
            <div class="mb-3 form-check uk-marketing-opt-in">
                <input type="checkbox"
                       class="form-check-input"
                       id="x_marketing_opt_in"
                       name="x_marketing_opt_in"
                       t-att-checked="'checked' if (not partner_sudo or partner_sudo.id == request.website.user_id.sudo().partner_id.id or partner_sudo.x_marketing_opt_in) else None"/>
                <label class="form-check-label" for="x_marketing_opt_in">
                    I’d like to receive news, offers, and product updates by email.
                </label>
            </div>
        </xpath>
    </template>

    <template id="website_sale_address_shipping_custom" inherit_id="website_sale.address" name="Inline Shipping Address Form">
        <xpath expr="//t[@t-call='website_sale.address_form_fields']" position="after">
            <!-- Toggle for shipping address -->
            <div class="mb-4 form-check uk-shipping-address-toggle-container py-2 border-top border-bottom" t-if="not address_type or address_type == 'billing'">
                <input type="checkbox"
                       class="form-check-input"
                       id="use_different_shipping"
                       name="use_different_shipping"
                       t-att-checked="'checked' if website_sale_order.partner_shipping_id and website_sale_order.partner_shipping_id.id != website_sale_order.partner_id.id else None"/>
                <label class="form-check-label fw-bold text-primary" for="use_different_shipping">
                    Ship to a different address
                </label>
            </div>

            <!-- Shipping address fields container -->
            <div id="shipping_address_fields" class="d-none mt-4 p-4 border rounded bg-light" t-if="not address_type or address_type == 'billing'">
                <h4 class="mb-3 text-secondary border-bottom pb-2">Shipping Address</h4>
                
                <!-- Row for First & Last Name -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="col-form-label" for="shipping_first_name">First Name</label>
                        <input type="text"
                               name="shipping_first_name"
                               id="shipping_first_name"
                               class="form-control"
                               t-att-value="website_sale_order.partner_shipping_id.x_first_name if (website_sale_order.partner_shipping_id and website_sale_order.partner_shipping_id.id != website_sale_order.partner_id.id) else ''"/>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label" for="shipping_last_name">Last Name</label>
                        <input type="text"
                               name="shipping_last_name"
                               id="shipping_last_name"
                               class="form-control"
                               t-att-value="website_sale_order.partner_shipping_id.x_last_name if (website_sale_order.partner_shipping_id and website_sale_order.partner_shipping_id.id != website_sale_order.partner_id.id) else ''"/>
                    </div>
                </div>

                <!-- Phone -->
                <div class="mb-3">
                    <label class="col-form-label" for="shipping_phone">Phone</label>
                    <input type="tel"
                           name="shipping_phone"
                           id="shipping_phone"
                           class="form-control"
                           placeholder="e.g. +44 7123 456789 or 07123 456789"
                           t-att-value="website_sale_order.partner_shipping_id.phone if (website_sale_order.partner_shipping_id and website_sale_order.partner_shipping_id.id != website_sale_order.partner_id.id) else ''"/>
                </div>

                <!-- Street and Number -->
                <div class="mb-3">
                    <label class="col-form-label" for="shipping_street">Street and Number</label>
                    <input type="text"
                           name="shipping_street"
                           id="shipping_street"
                           class="form-control"
                           t-att-value="website_sale_order.partner_shipping_id.street if (website_sale_order.partner_shipping_id and website_sale_order.partner_shipping_id.id != website_sale_order.partner_id.id) else ''"/>
                </div>

                <!-- Apartment, suite, etc. -->
                <div class="mb-3">
                    <label class="col-form-label" for="shipping_street2">Apartment, suite, etc. (optional)</label>
                    <input type="text"
                           name="shipping_street2"
                           id="shipping_street2"
                           class="form-control"
                           t-att-value="website_sale_order.partner_shipping_id.street2 if (website_sale_order.partner_shipping_id and website_sale_order.partner_shipping_id.id != website_sale_order.partner_id.id) else ''"/>
                </div>

                <!-- Row for City & Postal Code -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="col-form-label" for="shipping_city">City</label>
                        <input type="text"
                               name="shipping_city"
                               id="shipping_city"
                               class="form-control"
                               t-att-value="website_sale_order.partner_shipping_id.city if (website_sale_order.partner_shipping_id and website_sale_order.partner_shipping_id.id != website_sale_order.partner_id.id) else ''"/>
                    </div>
                    <div class="col-md-6">
                        <label class="col-form-label" for="shipping_zip">Postal Code</label>
                        <input type="text"
                               name="shipping_zip"
                               id="shipping_zip"
                               class="form-control"
                               placeholder="e.g. SW1A 1AA"
                               style="text-transform: uppercase;"
                               oninput="this.value = this.value.toUpperCase()"
                               t-att-value="website_sale_order.partner_shipping_id.zip if (website_sale_order.partner_shipping_id and website_sale_order.partner_shipping_id.id != website_sale_order.partner_id.id) else ''"/>
                    </div>
                </div>

                <!-- Hidden Country (Locked to UK) -->
                <input type="hidden" name="shipping_country_id" t-att-value="request.website.company_id.country_id.id or 233"/>
            </div>
        </xpath>
    </template>
</odoo>
