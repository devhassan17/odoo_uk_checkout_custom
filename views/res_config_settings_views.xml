<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Settings form inheritance to expose the country filter field -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.uk.checkout.custom</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="UK Checkout Settings" name="odoo_uk_checkout_custom">
                    <block title="General Checkout Settings" name="uk_checkout_general_block">
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="company_id" string="Active Company"/>
                                    <div class="text-muted">Select the Odoo company you are currently configuring.</div>
                                    <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="x_checkout_country_ids"/>
                                    <div class="text-muted">Restrict website checkout to only these countries for the active company. Leave empty to default to United Kingdom only.</div>
                                    <field name="x_checkout_country_ids" widget="many2many_tags" placeholder="Select countries..."/>
                                </div>
                            </div>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Company Checkout Filters Page Views & Window Action -->
    <record id="uk_res_company_checkout_filter_view_list" model="ir.ui.view">
        <field name="name">res.company.checkout.filter.view.list</field>
        <field name="model">res.company</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Company Checkout Filters" create="false" delete="false">
                <field name="name"/>
                <field name="x_checkout_country_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="uk_res_company_checkout_filter_view_form" model="ir.ui.view">
        <field name="name">res.company.checkout.filter.view.form</field>
        <field name="model">res.company</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Company Checkout Filter" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_checkout_country_ids" widget="many2many_tags" placeholder="Select allowed countries..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uk_company_checkout_filter" model="ir.actions.act_window">
        <field name="name">Company Checkout Filters</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('uk_res_company_checkout_filter_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('uk_res_company_checkout_filter_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure country filters for checkout per company.
            </p>
        </field>
    </record>

    <!-- Custom Menu Structure -->
    <menuitem id="menu_uk_checkout_custom_root"
              name="UK Checkout Customisations"
              sequence="50"/>

    <menuitem id="menu_uk_company_checkout_filter"
              name="Company Checkout Filters"
              parent="menu_uk_checkout_custom_root"
              action="action_uk_company_checkout_filter"
              sequence="10"/>

</odoo>
